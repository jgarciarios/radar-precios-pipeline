# Airflow runtime (generado por los contenedores, no es código)
logs/
plugins/
data/

# Credenciales / entorno local - regla del proyecto: nunca commitear esto
.env
# La key de la service account de GCP vive fuera del repo (~/.gcp/), pero
# esto es para que ni por accidente quede adentro si alguna vez se la copia
# a mano a esta carpeta. Este proyecto no tiene ningún .json legítimo para
# versionar (no es un proyecto JS), así que se puede ser así de amplio.
*.json
secrets/

# Python
__pycache__/
*.pyc
.venv/

# dbt (fase 3) - runtime generado al correr dbt, no es código.
# logs/ ya está cubierto arriba (sin / inicial, aplica a cualquier nivel).
dbt/radar_precios/target/
dbt/radar_precios/dbt_packages/
dbt/radar_precios/.user.yml

# OS
.DS_Store
