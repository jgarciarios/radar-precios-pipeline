# Copiar este archivo a .env (que está en .gitignore) y ajustar si hace falta.

# UID del usuario host, para que los archivos que escribe Airflow en logs/ y data/
# queden con tus permisos y no con los de root. En Mac/Windows con Docker Desktop
# no es estrictamente necesario, pero en Linux sí.
AIRFLOW_UID=50000

# Credenciales de la base de datos de metadata de Airflow (Postgres).
# Son locales, solo viven dentro de la red de Docker Compose - igual no se commitean.
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Clave Fernet para que Airflow encripte conexiones/variables sensibles en su metadata DB.
# Generarla con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
